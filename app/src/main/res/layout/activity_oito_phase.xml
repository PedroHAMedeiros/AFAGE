<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivityOitoPhase">

    <!-- Título -->
    <TextView
        android:id="@+id/textView_title_oito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Numere as imagens de acordo com a frase correspondente:"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Imagens (3 imagens) -->
    <ImageView
        android:id="@+id/image_1_oito"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/sapomola"
        app:layout_constraintTop_toBottomOf="@id/textView_title_oito"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editText_image_1_oito"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="NUMERO"
        app:layout_constraintTop_toBottomOf="@id/image_1_oito"
        app:layout_constraintStart_toStartOf="@id/image_1_oito" />

    <ImageView
        android:id="@+id/image_2_oito"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        android:src="@drawable/cafevovo"
        app:layout_constraintTop_toBottomOf="@id/textView_title_oito"
        app:layout_constraintStart_toEndOf="@id/image_1_oito" />

    <EditText
        android:id="@+id/editText_image_2_oito"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="NUMERO"
        app:layout_constraintTop_toBottomOf="@id/image_2_oito"
        app:layout_constraintStart_toStartOf="@id/image_2_oito" />

    <ImageView
        android:id="@+id/image_3_oito"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        android:src="@drawable/motobeto"
        app:layout_constraintTop_toBottomOf="@id/textView_title_oito"
        app:layout_constraintStart_toEndOf="@id/image_2_oito" />

    <EditText
        android:id="@+id/editText_image_3_oito"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="NUMERO"
        app:layout_constraintTop_toBottomOf="@id/image_3_oito"
        app:layout_constraintStart_toStartOf="@id/image_3_oito" />

    <!-- Frases -->

    <!-- Botão de Verificação -->
    <TextView
        android:id="@+id/textView_phrase_1_oito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="136dp"
        android:layout_marginTop="24dp"
        android:text="1. O CAFÉ É DO VOVÔ"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editText_image_3_oito" />

    <TextView
        android:id="@+id/textView_phrase_2_oito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="140dp"
        android:layout_marginTop="12dp"
        android:text="2. O SAPO E A MOLA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_phrase_1_oito" />

    <TextView
        android:id="@+id/textView_phrase_3_oito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="140dp"
        android:layout_marginTop="8dp"
        android:text="3. A MOTO É DE BETO"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_phrase_2_oito" />

    <Button
        android:id="@+id/button_verify_oito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verificar"
        app:layout_constraintTop_toBottomOf="@id/textView_phrase_3_oito"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <ImageView
        android:id="@+id/image_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="8dp"
        android:contentDescription="Logo da empresa"
        android:src="@drawable/logofinal2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
