<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecione uma Fase"
        android:textSize="24sp"
        android:layout_marginBottom="20dp"/>

    <!-- Botão para a Fase 1 -->
    <Button
        android:id="@+id/button_phase1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fase 1"/>

    <!-- Botão para a Fase 2 -->
    <Button
        android:id="@+id/button_phase2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fase 2"/>

    <!-- Botão para a Fase 3 -->
    <Button
        android:id="@+id/button_phase3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fase 3"/>

    <!-- Botão para a Fase 4 -->
    <Button
        android:id="@+id/button_phase4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fase 4"/>

    <!-- Botão para a Fase 5 -->
    <Button
        android:id="@+id/button_phase5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fase 5"/>
</LinearLayout>
